# Copy this file to .env and replace every value before starting the server.
PORT=10000
PUBLIC_URL=http://localhost:10000
FRONTEND_URL=http://localhost:10000

# Generate a random secret with at least 32 characters.
JWT_SECRET=

# Used only to create the first authorized IMO SN administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP configuration for contact and password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional deployment settings.
# DATA_FILE=./data/db.json
# API_BASE_URL=

# Optional Supabase persistence. Run supabase-schema.sql in the Supabase SQL
# Editor first. Use the Project URL and a server-only secret key; never put the
# secret key or a service_role key in frontend code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Without both Supabase values, the app continues to use data/db.json.
# The free Render filesystem is ephemeral; Supabase is recommended for
# production persistence.
